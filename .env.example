# ── Bot Secrets ──────────────────────────────────────────────
# Get your token from https://discord.com/developers/applications
DISCORD_TOKEN=your_token_here
DATABASE_URL=
OwnerId=
# ── Monitoring ───────────────────────────────────────────────
